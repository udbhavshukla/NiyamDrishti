# NiyamDrishti — Environment Template (PLACEHOLDERS ONLY — never real secrets)
# Copy to `.env` (backend) or export in your shell. Never commit `.env`.

# Database: leave unset for zero-config SQLite, or point at PostgreSQL.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/niyamdrishti

# REQUIRED. App fails closed without it (login 500, guarded routes 401).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Server
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins (credentials allowed only with explicit list).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Evidence storage (relative to backend/)
EVIDENCE_STORAGE_PATH=./uploads/evidence

# Frontend (Vite): point the React app at the backend.
# VITE_API_BASE_URL=http://localhost:8000

# OCR: set to 1 only if you want EasyOCR to download models (default offline).
# EASYOCR_DOWNLOAD=0
